---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured).slice(0, 4);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={profile.name} description="Technical portfolio for Colin Aysun, an MIT Electrical Engineering with Computing student.">
  <section class="hero">
    <div class="hero__text">
      <p class="eyebrow">{profile.school} / {profile.degree}</p>
      <h1>Engineering projects across robotics, machine learning, hardware, and app development.</h1>
      <p>
        I have independently explored diverse fields of engineering, from model airplane design to
        machine learning-enhanced color detection, with a focus on practical systems and problem-solving.
      </p>
      <div class="button-row">
        <a class="button" href={`${base}projects/`}>View projects</a>
        <a class="button button--secondary" href={`${base}resume.pdf`}>Resume PDF</a>
      </div>
    </div>
    <div class="hero__links" aria-label="Profile links">
      <a href={profile.github}>GitHub</a>
      <a href={profile.linkedin}>LinkedIn</a>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Featured Work</p>
      <h2>Selected technical projects</h2>
    </div>
    <div class="project-grid">
      {featured.map((project) => <ProjectCard project={project} href={`${base}projects/${project.id}/`} />)}
    </div>
  </section>
</BaseLayout>
