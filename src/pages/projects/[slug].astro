---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="project-page">
    <header class="project-hero">
      <p class="eyebrow">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      <ul class="tag-list">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    <section class="project-facts" aria-label="Project facts">
      <div>
        <h2>Role</h2>
        <p>{project.data.role}</p>
      </div>
      <div>
        <h2>Tools</h2>
        <p>{project.data.tools.join(', ')}</p>
      </div>
      {project.data.results.length > 0 && (
        <div>
          <h2>Key Results</h2>
          <ul>
            {project.data.results.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
      {project.data.links.length > 0 && (
        <div>
          <h2>Links</h2>
          <ul>
            {project.data.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      )}
    </section>

    <div class="content">
      <Content />
    </div>

    {project.data.images.length > 0 && (
      <section class="figure-grid" aria-label="Project figures">
        {project.data.images.map((image) => (
          <figure>
            <img src={`${base}${image.src}`} alt={image.alt} loading="lazy" />
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {project.data.todo.length > 0 && (
      <section class="todo-note" aria-labelledby="todo-title">
        <h2 id="todo-title">TODO</h2>
        <ul>
          {project.data.todo.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
